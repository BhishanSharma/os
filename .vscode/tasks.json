{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (Docker)",
      "type": "shell",
      "command": "docker run --rm -v \"${workspaceFolder}:/root/env\" myos-buildenv make build-x86_64",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "c",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(src/.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      "label": "Run in QEMU",
      "type": "shell",
      "command": "qemu-system-x86_64 -cdrom dist/x86_64/kernel.iso -drive file=disk.img,format=raw,index=0,media=disk -boot d -device rtl8139,netdev=n0 -netdev user,id=n0",
      "problemMatcher": []
    },
    {
      "label": "Build + Run",
      "dependsOrder": "sequence",
      "dependsOn": ["Build (Docker)", "Run in QEMU"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "docker run --rm -v \"${workspaceFolder}:/root/env\" myos-buildenv make clean",
      "problemMatcher": []
    }
  ]
}
