diff --git a/pb/src/intf/drivers/pic.h b/src/intf/drivers/pic.h
new file mode 100644
index 0000000..8f4bb61
--- /dev/null
+++ b/src/intf/drivers/pic.h
@@ -0,0 +1,13 @@
+#ifndef PIC_H
+#define PIC_H
+
+#include <stdint.h>
+
+// Remap the 8259 PICs to vectors 0x20-0x2F and mask everything except IRQ1.
+void pic_remap(void);
+
+// Unmask one IRQ line (0-15). IRQs 8-15 live on the slave PIC, so this also
+// unmasks the cascade line (IRQ2) on the master.
+void enable_irq(uint8_t irq);
+
+#endif
